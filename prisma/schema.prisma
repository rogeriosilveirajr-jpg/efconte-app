generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  passwordHash String
  role         String       @default("CLIENTE")
  tenants      UserTenant[]
}

model Tenant {
  id               String         @id @default(uuid())
  name             String
  cnpj             String         @unique
  phone            String?
  isAnnualContract Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isDeleted        Boolean        @default(false)

  users            UserTenant[]
  subscription     Subscription?
  employees        Employee[]
  partners         Partner[]
  invoices         Invoice[]
  notifications    Notification[]
  meetings         Meeting[]
  documents        Document[]
}

model UserTenant {
  id        String   @id @default(uuid())
  userId    Int
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model Plan {
  id           String         @id @default(uuid())
  name         String         // START | GESTAO | PRIME
  basePrice    Float
  maxEmployees Int
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  planId    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
  active    Boolean  @default(true)
}

model Employee {
  id        String   @id @default(uuid())
  name      String
  role      String?
  salary    Float?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isDeleted Boolean  @default(false)
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isDeleted Boolean  @default(false)
}

model Invoice {
  id          String         @id @default(uuid())
  tenantId    String
  dueDate     DateTime
  totalAmount Float
  status      String         @default("Pending") // Pending | Paid
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  items       InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  amount      Float
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // ADMISSAO, DEMISSAO, DOCUMENTO, REUNIAO
  message     String
  metadata    String?  // JSON stringified (e.g. employeeId, fileNames)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

// Comercial / CRM
model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  status    String   // NEW, CONTACTED, PROPOSAL, WON, LOST
  sourceUrl String?  // Origem do lead (agência de publicidade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reuniões Estratégicas
model Meeting {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  status      String   // SCHEDULED, COMPLETED, CANCELED
  meetingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

// Documentos
model Document {
  id           String    @id @default(uuid())
  tenantId     String
  title        String
  fileUrl      String
  fileData     String?   
  type         String    @default("OUTROS") // CONTRATO, IMPOSTO, DP, OUTROS
  status       String?   // PENDING, SIGNED (usado para contratos)
  signatureUrl String?   // URL da imagem da assinatura
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
}

model Setting {
  key   String @id
  value String
}
